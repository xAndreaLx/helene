---
export const prerender = false;

import AdminForm from '../../components/AdminForm.svelte';
import Toast from '../../components/Toast.svelte';
import staticReferentiel from '../../data/referentiel-botanique.json';
import MainLayout from '../../layouts/MainLayout.astro';
import { db } from '../../db/index';
import { referentiels } from '../../db/schema';
import { getPlante } from '../../db/plantes';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;

// La fiche à éditer doit exister, sinon 404.
const plante = await getPlante(id!);
if (!plante) {
  return Astro.redirect('/404');
}

// Référentiel enrichi depuis la BDD (repli sur le JSON statique).
const row = await db.select().from(referentiels).where(eq(referentiels.id, 'principal')).get();
const referentielData = (row?.data as typeof staticReferentiel) ?? staticReferentiel;
---

<MainLayout title={`Modifier ${plante.common_name}`}>
  <main>
    <Toast client:load />
    <AdminForm client:load referentiel={referentielData} plante={plante} />
  </main>
</MainLayout>
