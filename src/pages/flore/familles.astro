---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { getFamilles } from '../../db/plantes';

const familles = await getFamilles();
---

<MainLayout title="Familles botaniques">
  <header class="page-head">
    <p class="kicker">Classification</p>
    <h1>Familles botaniques</h1>
    <p class="lede">{familles.length} familles représentées dans l'herbier.</p>
  </header>

  <ul class="familles-grid">
    {familles.map((f) => (
      <li class="card">
        <a href={`/flore/famille/${f.slug}`}>
          <span class="nom">{f.famille}</span>
          <span class="count">{f.species.length} {f.species.length > 1 ? 'espèces' : 'espèce'}</span>
        </a>
      </li>
    ))}
  </ul>
</MainLayout>

<style>
  .page-head { text-align: center; margin-bottom: 2rem; }
  .kicker {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 0.9rem;
    color: var(--gold);
    margin: 0 0 0.2rem;
  }
  .page-head h1 { margin: 0 0 0.3rem; }
  .lede { color: var(--ink-soft); margin: 0; font-size: 1.15rem; }

  .familles-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .familles-grid .card { transition: transform 0.18s, box-shadow 0.2s, border-color 0.2s; }
  .familles-grid .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-left-color: var(--madder); }
  .familles-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem;
    text-decoration: none;
  }

  .nom { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; color: var(--forest); }
  .count { font-size: 0.9rem; color: var(--ink-soft); }
</style>
