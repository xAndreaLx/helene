---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { getPlantes } from '../../db/plantes';

// Lecture directe en base : une plante ajoutée via /admin apparaît aussitôt.
const toutesLesPlantes = await getPlantes();

// Filtre par niveau de certification SBS/InfoFlora (200 / 400 / 600).
const NIVEAUX = [200, 400, 600];
const param = Astro.url.searchParams.get('niveau');
const niveauActif = NIVEAUX.includes(Number(param)) ? Number(param) : null;

const compte = (n: number | null) =>
  n === null ? toutesLesPlantes.length : toutesLesPlantes.filter((p) => p.niveau === n).length;

const plantes = (niveauActif
  ? toutesLesPlantes.filter((p) => p.niveau === niveauActif)
  : toutesLesPlantes
).sort((a, b) => a.common_name.localeCompare(b.common_name, 'fr'));
---

<MainLayout title="La Flore">
  <header class="page-head">
    <p class="kicker">L'herbier</p>
    <h1>La Flore</h1>
    <p class="lede">
      {plantes.length} espèce{plantes.length > 1 ? 's' : ''}
      {niveauActif ? ` · niveau de certification ${niveauActif}` : ''}.
    </p>
    <nav class="sous-nav" aria-label="Sections de la flore">
      <a href="/flore/theorie">📖 Théorie botanique</a>
      <a href="/flore/familles">🌿 Par famille</a>
    </nav>
  </header>

  <nav class="filtres" aria-label="Filtrer par niveau de certification">
    <a href="/flore" class={niveauActif === null ? 'actif' : ''}>Toutes ({compte(null)})</a>
    {NIVEAUX.map((n) => (
      <a href={`/flore?niveau=${n}`} class={`niv-dot niv-${n} ${niveauActif === n ? 'actif' : ''}`}>
        Niveau {n} ({compte(n)})
      </a>
    ))}
  </nav>

  <ul class="grille">
    {plantes.map((plante) => (
      <li class="card">
        <a href={`/flore/${plante.id}`}>
          {plante.image_ref ? (
            <span class="vignette" style={`background-image:url('${plante.image_ref}')`}></span>
          ) : (
            <span class="vignette vide"><span>🌿</span></span>
          )}
          <span class="corps">
            <span class="nom">{plante.common_name}</span>
            <span class="latin"><i>{plante.latin_name}</i></span>
          </span>
          {plante.niveau && <span class={`badge-niv niv-${plante.niveau}`}>{plante.niveau}</span>}
        </a>
      </li>
    ))}
  </ul>
</MainLayout>

<style>
  .page-head { text-align: center; margin-bottom: 1.5rem; }
  .kicker {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 0.9rem;
    color: var(--gold);
    margin: 0 0 0.2rem;
  }
  .page-head h1 { margin: 0 0 0.3rem; }
  .lede { color: var(--ink-soft); margin: 0; font-size: 1.15rem; }

  .sous-nav { display: flex; gap: 1.5rem; justify-content: center; margin-top: 0.8rem; }
  .sous-nav a {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--leaf);
    text-decoration: none;
    border-bottom: 1px dotted var(--leaf);
  }
  .sous-nav a:hover { color: var(--forest); }

  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin: 0 0 2rem;
  }
  .filtres a {
    font-family: var(--font-display);
    font-size: 1.02rem;
    padding: 0.35rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--forest);
    background: var(--cream);
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }
  .filtres a:hover { border-color: var(--leaf); }
  .filtres a.actif { background: var(--forest); color: var(--cream); border-color: var(--forest); }
  /* point coloré devant les filtres de niveau */
  .niv-dot::before {
    content: '';
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    margin-right: 0.45rem;
    vertical-align: 1px;
  }
  .niv-dot.niv-200::before { background: var(--niv-200); }
  .niv-dot.niv-400::before { background: var(--niv-400); }
  .niv-dot.niv-600::before { background: var(--niv-600); }
  .filtres a.actif.niv-dot::before { background: var(--cream); }

  .grille {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.2rem;
  }
  .grille .card { padding: 0; overflow: hidden; transition: transform 0.18s, box-shadow 0.2s, border-color 0.2s; }
  .grille .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-left-color: var(--madder); }
  .grille a {
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
  }
  .vignette {
    display: block;
    aspect-ratio: 4 / 5;
    background-size: cover;
    background-position: center;
    background-color: var(--parchment-2);
    border-bottom: 1px solid var(--line);
  }
  .vignette.vide { display: grid; place-items: center; color: var(--sage); font-size: 2.4rem; }
  .corps { padding: 0.7rem 0.9rem 0.9rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .nom { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--forest); line-height: 1.15; }
  .latin { font-size: 0.92rem; color: var(--ink-soft); }
  .badge-niv { position: absolute; top: 0.55rem; right: 0.55rem; box-shadow: var(--shadow-sm); }
</style>
