---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { getPlantes } from '../../db/plantes';

// Lecture directe en base : une plante ajoutée via /admin apparaît aussitôt.
const toutesLesPlantes = await getPlantes();
---

<MainLayout title="Mon Herbier">

  <h2>Théorie</h2>
  <a href="/flore/theorie">Découvrir les formes des feuilles, types d'inflorescences, etc.</a>
    <hr>

  <h2>Ma collection ({toutesLesPlantes.length} plantes)</h2>

  <ul>
    {toutesLesPlantes.map(plante => (
      <li>
        {/* L'URL sera /flore/pissenlit */}
        <a href={`/flore/${plante.id}`}>
          <strong>{plante.common_name}</strong> (<i>{plante.latin_name}</i>)
        </a>
      </li>
    ))}
  </ul>

  
</MainLayout>
