---
export const prerender = false;

import MainLayout from '../../../layouts/MainLayout.astro';
import { getFamille } from '../../../db/plantes';

const { slug } = Astro.params;
const famille = await getFamille(slug!);
if (!famille) {
  return Astro.redirect('/404');
}
---

<MainLayout title={`Famille ${famille.famille}`}>
  <p class="breadcrumb"><a href="/flore/familles">← Toutes les familles</a></p>
  <h1>{famille.famille}</h1>
  <p class="intro">{famille.species.length} espèce{famille.species.length > 1 ? 's' : ''} dans la collection.</p>

  <ul class="species-grid">
    {famille.species.map((p) => (
      <li>
        <a href={`/flore/${p.id}`}>
          {p.image_ref ? (
            <img src={p.image_ref} alt={p.common_name} loading="lazy" />
          ) : (
            <div class="no-img">—</div>
          )}
          <span class="latin"><i>{p.latin_name}</i></span>
        </a>
      </li>
    ))}
  </ul>
</MainLayout>

<style>
  .breadcrumb { margin-bottom: 0.5rem; }
  .breadcrumb a { color: #2e7d32; text-decoration: none; }
  h1 { color: #1b5e20; margin: 0; }
  .intro { color: #666; margin-bottom: 2rem; }

  .species-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.2rem;
  }

  .species-grid a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .species-grid img,
  .species-grid .no-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #ddd;
    background: #f4f4f4;
  }

  .species-grid .no-img {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #bbb;
    font-size: 2rem;
  }

  .latin {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: #333;
  }
</style>
