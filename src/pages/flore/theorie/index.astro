---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const definitions = await getCollection('theorie');

const categories = {
  forme_feuille: 'Formes des feuilles',
  bord_feuille: 'Bords des feuilles',
  nervure: 'Nervures des feuilles',
  inflorescence: "Types d'inflorescences",
};

const slugId = (label: string) => label.toLowerCase().replace(/\s+/g, '-').replace(/'/g, '');

// Sections non vides uniquement, avec leurs entrées.
const sections = Object.entries(categories)
  .map(([key, label]) => ({
    key,
    label,
    id: slugId(label),
    items: definitions.filter((item) => item.data.categorie === key),
  }))
  .filter((s) => s.items.length > 0);
---

<MainLayout title="Atlas Botanique">
  <header class="page-head">
    <p class="kicker">Théorie</p>
    <h1>Atlas Botanique</h1>
    <p class="lede">Le vocabulaire illustré pour décrire et déterminer les plantes.</p>
  </header>

  <nav class="sommaire" aria-label="Sommaire de l'atlas">
    {sections.map((s) => (
      <a href={`#${s.id}`}>{s.label} <span class="n">{s.items.length}</span></a>
    ))}
  </nav>

  {sections.map((s) => (
    <section class="atlas-section">
      <h2 id={s.id} class="section-titre"><span class="leaf">❧</span>{s.label}</h2>
      <div class="grid">
        {s.items.map((item) => (
          <article class="t-card card">
            <div class={`t-plate ${item.data.image2 ? 'duo' : ''}`}>
              <Image src={item.data.image} alt={item.data.title} width={400} />
              {item.data.image2 && <Image src={item.data.image2} alt={item.data.title} width={400} />}
            </div>
            <div class="t-body">
              <h3>{item.data.title}</h3>
              <p>{item.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</MainLayout>

<style>
  .page-head { text-align: center; margin-bottom: 1.5rem; }
  .kicker {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 0.9rem;
    color: var(--gold);
    margin: 0 0 0.2rem;
  }
  .page-head h1 { margin: 0 0 0.3rem; }
  .lede { color: var(--ink-soft); margin: 0; font-size: 1.15rem; }

  /* Sommaire en pastilles */
  .sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin: 0 0 2.5rem;
  }
  .sommaire a {
    font-family: var(--font-display);
    font-size: 1.02rem;
    padding: 0.35rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--forest);
    background: var(--cream);
    transition: border-color 0.18s, background 0.18s;
  }
  .sommaire a:hover { border-color: var(--leaf); background: var(--parchment-2); }
  .sommaire .n {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-left: 0.15rem;
  }

  /* Titre de section orné */
  .atlas-section { margin-bottom: 3rem; scroll-margin-top: 1.5rem; }
  .section-titre {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--line);
  }
  .section-titre .leaf { color: var(--gold); font-size: 1.3rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.4rem;
  }

  .t-card {
    overflow: hidden;
    transition: transform 0.18s, box-shadow 0.2s, border-color 0.2s;
  }
  .t-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-left-color: var(--madder); }

  /* La « planche » : fond crème, illustration centrée façon herbier */
  .t-plate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 180px;
    padding: 0.8rem;
    background:
      radial-gradient(circle at 50% 40%, #fff, var(--cream));
    border-bottom: 1px solid var(--line);
  }
  .t-plate :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply; /* fond papier des planches anciennes fondu dans le crème */
  }
  .t-plate.duo :global(img) { max-width: 48%; }

  .t-body { padding: 0.9rem 1.1rem 1.1rem; }
  .t-body h3 {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--forest);
  }
  .t-body p { font-size: 1rem; color: var(--ink-soft); margin: 0; line-height: 1.5; }
</style>
