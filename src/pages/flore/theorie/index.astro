---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
// 1. IMPORTATION DU COMPOSANT IMAGE
import { Image } from 'astro:assets';

const definitions = await getCollection('theorie');

const categories = {
  forme_feuille: "Formes des feuilles",
  bord_feuille: "Bords des feuilles",
  nervure: "Nervures des feuilles",
  inflorescence: "Types d'inflorescences"
};
---

<MainLayout title="Atlas Botanique">
  <main class="atlas-container">
    <h1>Atlas Botanique</h1>

    <nav class="sommaire">
      {Object.values(categories).map(label => (
        <a href={`#${label.toLowerCase().replace(/\s+/g, '-').replace(/'/g, '')}`}>{label}</a>
      ))}
    </nav>

    {Object.entries(categories).map(([key, label]) => (
      <section>
        <h2 id={label.toLowerCase().replace(/\s+/g, '-').replace(/'/g, '')}>{label}</h2>
        <div class="grid">
          {definitions
            .filter(item => item.data.categorie === key)
            .map(item => (
              <div class="card-theorie">
                <div class="image-wrapper">
                <Image 
                  src={item.data.image} 
                  alt={item.data.title}
                  width={400}
                />
                {/* Optionnel : Afficher la 2ème image si elle existe (ex: Capitule) */}
                {item.data.image2 && (
                  <Image 
                    src={item.data.image2} 
                    alt={item.data.title}
                    width={400}
                  />
                )}
                </div>
                <div class="content">
                  <h3>{item.data.title}</h3>
                  <p>{item.data.description}</p>
                </div>
              </div>
            ))}
        </div>
      </section>
    ))}
  </main>
</MainLayout>

<style>
  .sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 30px;
    padding: 12px 16px;
    background: #f5f5f5;
    border-radius: 8px;
  }
  .sommaire a {
    color: #2e7d32;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .sommaire a:hover { text-decoration: underline; }
  .atlas-container { max-width: 1000px; margin: 0 auto; padding: 20px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .card-theorie {
    border: 1px solid #eee;
    border-radius: 12px;
    overflow: hidden;
    background: white;
    transition: transform 0.2s;
  }
  .card-theorie:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
  .card-theorie img {
    max-width: 100%;   /* Ne dépasse pas la carte */
    width: auto;       /* Garde sa taille naturelle si elle est plus petite */
    height: 150px;
    object-fit: contain;
    background: #f9f9f9;
    padding: 10px;
  }
  .content { padding: 15px; }
  h3 { margin: 0; color: #2e7d32; font-size: 1.1rem; }
  p { font-size: 0.85rem; color: #666; margin-top: 8px; }
</style>
