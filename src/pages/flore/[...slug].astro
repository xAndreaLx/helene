---
// src/pages/flore/[...slug].astro
export const prerender = false;

import { marked } from 'marked';
import MainLayout from '../../layouts/MainLayout.astro';
import { getPlante } from '../../db/plantes';

// 1. Récupérer le slug depuis l'URL
const { slug } = Astro.params;

// 2. Lire la plante directement en base (visibilité immédiate après ajout)
const plante = await getPlante(slug!);

// 3. Sécurité : si la plante n'existe pas
if (!plante) {
  return Astro.redirect('/404');
}

const { common_name, latin_name, description, image_ref, niveau } = plante;

const famille = plante.sections?.classification?.famille?.[0];
const slugify = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

const formatLabel = (str: string) => str.replace(/_/g, ' ');

// Sections affichées dynamiquement (dans l'ordre), avec leur titre et icône.
const SECTIONS = [
  { key: 'classification', title: 'Classification', icon: '🧬' },
  { key: 'generalites', title: 'Généralités', icon: '📍' },
  { key: 'appareil_vegetatif', title: 'Appareil Végétatif', icon: '🌿' },
  { key: 'inflorescence', title: 'Inflorescence', icon: '🌼' },
  { key: 'fleur_anatomie', title: 'Détails de la fleur', icon: '🔬' },
  { key: 'fruits_et_graines', title: 'Fruits & Graines', icon: '🌰' },
];

// On ne garde que les sections qui contiennent au moins une valeur renseignée.
const sectionsRemplies = SECTIONS.map((section) => ({
  ...section,
  entries: Object.entries(plante.sections[section.key] ?? {}).filter(
    ([, values]) => Array.isArray(values) && values.length > 0
  ),
})).filter((section) => section.entries.length > 0);
---

<MainLayout title={common_name}>
  <article class="botanical-sheet">
    <header>
      <div class="title-group">
        <p class="kicker">Fiche d'herbier</p>
        <h1>{common_name}</h1>
        <p class="latin-name"><i>{latin_name}</i></p>
        <p class="meta">
          {famille && <a class="meta-fam" href={`/flore/famille/${slugify(famille)}`}>{famille}</a>}
          {niveau && <span class={`badge-niv niv-${niveau}`}>Niveau {niveau}</span>}
        </p>
        <a class="edit-link" href={`/admin/${plante.id}`}>✏️ Éditer cette fiche</a>
      </div>

      {image_ref && (
        <div class="image-container">
          <img
            src={image_ref}
            alt={`Illustration de ${common_name}`}
            class="main-illustration"
          />
        </div>
      )}
    </header>

    <div class="details-grid">
      {sectionsRemplies.map((section) => (
        <section class="info-card">
          <h2>{section.icon} {section.title}</h2>
          <dl>
            {section.entries.map(([key, values]) => (
              <div>
                <dt>{formatLabel(key)}</dt>
                <dd>{values.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <hr />

    {description && (
      <section class="markdown-content">
        <h2>Description & Notes</h2>
        <!-- Description saisie en Markdown, rendue en HTML (admin = seul auteur de confiance) -->
        <div set:html={marked.parse(description)} />
      </section>
    )}
  </article>
</MainLayout>

<style>
  .botanical-sheet {
    max-width: 900px;
    margin: 0 auto;
  }

  .title-group {
    text-align: center;
    margin-bottom: 2rem;
  }

  .kicker {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 0.9rem;
    color: var(--gold);
    margin: 0 0 0.2rem;
  }

  h1 { margin: 0; }
  .latin-name { font-family: var(--font-display); font-size: 1.6rem; color: var(--ink-soft); margin: 0.3rem 0 0.6rem; }

  .meta {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0 0 0.8rem;
  }
  .meta-fam {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--leaf);
    text-decoration: none;
    border-bottom: 1px dotted var(--leaf);
  }
  .meta-fam:hover { color: var(--forest); }

  .edit-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.95rem;
    color: var(--forest);
    text-decoration: none;
    border: 1.5px solid var(--line);
    background: var(--cream);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    transition: border-color 0.2s;
  }
  .edit-link:hover { border-color: var(--leaf); }

  .main-illustration {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--cream);
    padding: 0.5rem;
    box-shadow: var(--shadow);
    margin-bottom: 2.5rem;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .info-card {
    background: var(--cream);
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    border-left: 4px solid var(--leaf);
  }

  .info-card h2 {
    font-size: 1.3rem;
    margin-top: 0;
    color: var(--forest);
    border-bottom: 1px solid var(--line-soft);
    padding-bottom: 0.5rem;
  }

  dl { margin: 0; }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px dashed var(--line-soft);
  }

  dt { font-weight: 600; color: var(--ink-soft); text-transform: capitalize; }
  dd { margin: 0; color: var(--ink); text-align: right; }

  hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.5rem auto;
    max-width: 300px;
  }

  .markdown-content {
    line-height: 1.8;
    color: var(--ink);
  }

  /* Le HTML est injecté via set:html (non scopé par Astro) → :global() requis. */
  .markdown-content :global(h2),
  .markdown-content :global(h3),
  .markdown-content :global(h4) {
    font-family: var(--font-display);
    color: var(--forest);
    margin: 1.4rem 0 0.5rem;
    line-height: 1.3;
  }

  .markdown-content :global(h3) { font-size: 1.4rem; }
  .markdown-content :global(h4) { font-size: 1.2rem; }

  .markdown-content :global(p) { margin: 0 0 1rem; }

  .markdown-content :global(ul),
  .markdown-content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .markdown-content :global(li) { margin-bottom: 0.3rem; }

  .markdown-content :global(strong) { color: var(--forest); }

  .markdown-content :global(a) { color: var(--madder); }

  .markdown-content :global(blockquote) {
    margin: 0 0 1rem;
    padding: 0.4rem 1.2rem;
    border-left: 4px solid var(--sage);
    background: var(--cream);
    color: var(--ink-soft);
    font-style: italic;
  }

  .markdown-content :global(code) {
    background: var(--parchment-2);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius);
    font-size: 0.9em;
  }
</style>
