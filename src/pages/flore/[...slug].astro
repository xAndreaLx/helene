---
// src/pages/flore/[...slug].astro
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { getPlante } from '../../db/plantes';

// 1. Récupérer le slug depuis l'URL
const { slug } = Astro.params;

// 2. Lire la plante directement en base (visibilité immédiate après ajout)
const plante = await getPlante(slug!);

// 3. Sécurité : si la plante n'existe pas
if (!plante) {
  return Astro.redirect('/404');
}

const { common_name, latin_name, description, image_ref } = plante;

const formatLabel = (str: string) => str.replace(/_/g, ' ');

// Sections affichées dynamiquement (dans l'ordre), avec leur titre et icône.
const SECTIONS = [
  { key: 'classification', title: 'Classification', icon: '🧬' },
  { key: 'generalites', title: 'Généralités', icon: '📍' },
  { key: 'appareil_vegetatif', title: 'Appareil Végétatif', icon: '🌿' },
  { key: 'inflorescence', title: 'Inflorescence', icon: '🌼' },
  { key: 'fleur_anatomie', title: 'Détails de la fleur', icon: '🔬' },
  { key: 'fruits_et_graines', title: 'Fruits & Graines', icon: '🌰' },
];

// On ne garde que les sections qui contiennent au moins une valeur renseignée.
const sectionsRemplies = SECTIONS.map((section) => ({
  ...section,
  entries: Object.entries(plante.sections[section.key] ?? {}).filter(
    ([, values]) => Array.isArray(values) && values.length > 0
  ),
})).filter((section) => section.entries.length > 0);
---

<MainLayout title={common_name}>
  <article class="botanical-sheet">
    <header>
      <div class="title-group">
        <h1>{common_name}</h1>
        <p class="latin-name"><i>{latin_name}</i></p>
      </div>

      {image_ref && (
        <div class="image-container">
          <img
            src={image_ref}
            alt={`Illustration de ${common_name}`}
            class="main-illustration"
          />
        </div>
      )}
    </header>

    <div class="details-grid">
      {sectionsRemplies.map((section) => (
        <section class="info-card">
          <h2>{section.icon} {section.title}</h2>
          <dl>
            {section.entries.map(([key, values]) => (
              <div>
                <dt>{formatLabel(key)}</dt>
                <dd>{values.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <hr />

    {description && (
      <section class="markdown-content">
        <h2>Description & Notes</h2>
        <p>{description}</p>
      </section>
    )}
  </article>
</MainLayout>

<style>
  .botanical-sheet {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: 'Segoe UI', system-ui, sans-serif;
  }

  .title-group {
    text-align: center;
    margin-bottom: 2rem;
  }

  h1 { font-size: 2.5rem; color: #1b5e20; margin: 0; }
  .latin-name { font-size: 1.5rem; color: #666; margin-top: 0.5rem; }

  .main-illustration {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    margin-bottom: 2.5rem;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .info-card {
    background: #f9fbf9;
    padding: 1.5rem;
    border-radius: 10px;
    border-left: 4px solid #2e7d32;
  }

  .info-card h2 {
    font-size: 1.1rem;
    margin-top: 0;
    color: #2e7d32;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 0.5rem;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px dashed #eee;
    font-size: 0.9rem;
  }

  dt { font-weight: 600; color: #555; text-transform: capitalize; }
  dd { margin: 0; color: #222; text-align: right; }

  .markdown-content {
    line-height: 1.8;
    color: #333;
    background: white;
    padding: 1rem;
  }

  .markdown-content p {
    white-space: pre-wrap;
  }
</style>
