# Base de données (libsql / Turso)
# En local, laisse ces variables vides : le driver retombe sur "file:sqlite.db".
# En production (Netlify), renseigne les deux valeurs fournies par Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary (upload d'images depuis le formulaire d'admin)
# Préfixe PUBLIC_ : ces valeurs sont exposées au navigateur (normal pour un
# upload non signé). Le "cloud name" et le nom du preset ne sont pas secrets.
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=
